#include <windows.h>
IDI_ICON1 ICON "@CC_ICON_FILE@"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @CC_RESOURCE_VERSION@
 PRODUCTVERSION @CC_RESOURCE_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "MabiTools\0"
   VALUE "FileDescription", "Channel Checker\0"
   VALUE "FileVersion", "@CC_APP_VERSION@\0"
   VALUE "ProductName", "MabiTools Channel Checker\0"
   VALUE "ProductVersion", "@CC_APP_VERSION@\0"
   VALUE "OriginalFilename", "MabiTools.ChannelChecker.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
